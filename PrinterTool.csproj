<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <!-- .NET Framework 4.8 ships inside Windows 11 → tiny exe, zero prerequisites -->
    <TargetFramework>net48</TargetFramework>
    <LangVersion>12</LangVersion>
    <UseWPF>true</UseWPF>
    <EnableWindowsTargeting>true</EnableWindowsTargeting>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <AssemblyName>PrinterConnect</AssemblyName>
    <RootNamespace>PrinterTool</RootNamespace>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <Version>3.9.0</Version>
    <Company>ClearVantage.io</Company>
    <Authors>ClearVantage.io</Authors>
    <Product>PrinterConnect</Product>
    <Copyright>© 2026 ClearVantage.io</Copyright>
    <AssemblyTitle>PrinterConnect</AssemblyTitle>
    <ApplicationIcon>app.ico</ApplicationIcon>
    <PlatformTarget>x64</PlatformTarget>
    <AutoGenerateBindingRedirects>true</AutoGenerateBindingRedirects>
  </PropertyGroup>

  <ItemGroup>
    <!-- Build-time only: modern C# feature polyfills + net48 reference assemblies.
         Nothing here ships with the exe. -->
    <PackageReference Include="PolySharp" Version="1.14.1" PrivateAssets="all" />
    <PackageReference Include="Microsoft.NETFramework.ReferenceAssemblies" Version="1.0.3" PrivateAssets="all" />
    <Reference Include="System.Runtime.Serialization" />
    <Reference Include="System.IO.Compression" />
    <Reference Include="System.IO.Compression.FileSystem" />
    <Resource Include="app.ico" />
    <Resource Include="logo.png" />
    <Resource Include="flags\**\*.png" />
  </ItemGroup>

</Project>
