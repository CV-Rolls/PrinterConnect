<Window x:Class="PrinterTool.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="clr-namespace:PrinterTool"
        Title="PrinterConnect" MinWidth="760" MinHeight="480"
        Background="{DynamicResource Paper}"
        FontFamily="Segoe UI Variable Text, Segoe UI"
        FontSize="13" Foreground="{DynamicResource Ink}"
        Icon="app.ico"
        WindowStartupLocation="CenterScreen">

    <Window.Resources>
        <!-- Shared row menu; its DataContext follows the right-clicked row -->
        <ContextMenu x:Key="RowMenu">
            <MenuItem Click="SetDefault_Click" Header="{Binding SetDefaultLabel}"/>
            <MenuItem Click="TestPage_Click" Header="{Binding TestPageLabel}"/>
            <MenuItem Click="ClearQueue_Click" Header="{Binding ClearQueueLabel}"/>
        </ContextMenu>
    </Window.Resources>

    <Grid Margin="16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Header: title · server · language -->
        <Grid Grid.Row="0" Margin="0,0,0,12">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>

            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                <Image Source="logo.png" Width="26" Height="26" Margin="0,0,10,0"
                       RenderOptions.BitmapScalingMode="HighQuality" VerticalAlignment="Center"/>
                <TextBlock x:Name="TitleText" Text="PrinterConnect" VerticalAlignment="Center"
                           FontFamily="Segoe UI Variable Display, Segoe UI"
                           FontSize="20" FontWeight="SemiBold"/>
            </StackPanel>

            <StackPanel Grid.Column="1" Orientation="Horizontal" HorizontalAlignment="Center" VerticalAlignment="Center">
                <TextBlock x:Name="ServerLabel" Text="Print server" Foreground="{DynamicResource InkSoft}"
                           VerticalAlignment="Center" Margin="0,0,8,0"/>
                <Grid>
                    <TextBox x:Name="ServerBox" Width="260" Style="{StaticResource ThemedTextBox}"
                             Padding="8,5,30,5" KeyDown="ServerBox_KeyDown"/>
                    <ToggleButton x:Name="ServerDrop" Width="26" HorizontalAlignment="Right"
                                  Margin="0,1,1,1" Cursor="Hand" Focusable="False">
                        <ToggleButton.Template>
                            <ControlTemplate TargetType="ToggleButton">
                                <Border x:Name="bd" Background="Transparent" CornerRadius="0,4,4,0">
                                    <Path Data="M0,0 L4,4 8,0" Stroke="{DynamicResource InkSoft}"
                                          StrokeThickness="1.4" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                </Border>
                                <ControlTemplate.Triggers>
                                    <Trigger Property="IsMouseOver" Value="True">
                                        <Setter TargetName="bd" Property="Background" Value="{DynamicResource Hover}"/>
                                    </Trigger>
                                </ControlTemplate.Triggers>
                            </ControlTemplate>
                        </ToggleButton.Template>
                    </ToggleButton>
                    <Popup IsOpen="{Binding IsChecked, ElementName=ServerDrop, Mode=TwoWay}"
                           PlacementTarget="{Binding ElementName=ServerBox}" Placement="Bottom"
                           AllowsTransparency="True" StaysOpen="False">
                        <Border Background="{DynamicResource Card}" BorderBrush="{DynamicResource Line}"
                                BorderThickness="1" CornerRadius="6" Margin="4" MinWidth="280">
                            <Border.Effect>
                                <DropShadowEffect BlurRadius="12" ShadowDepth="2" Opacity="0.25"/>
                            </Border.Effect>
                            <Grid>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                </Grid.RowDefinitions>
                            <ItemsControl x:Name="ServerList" Margin="3">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="Auto"/>
                                            </Grid.ColumnDefinitions>
                                            <Button Content="{Binding}" Click="ServerItem_Click"
                                                    HorizontalContentAlignment="Left" Cursor="Hand"
                                                    Foreground="{DynamicResource Ink}">
                                                <Button.Template>
                                                    <ControlTemplate TargetType="Button">
                                                        <Border x:Name="bd" Background="Transparent" CornerRadius="4" Padding="10,7">
                                                            <ContentPresenter/>
                                                        </Border>
                                                        <ControlTemplate.Triggers>
                                                            <Trigger Property="IsMouseOver" Value="True">
                                                                <Setter TargetName="bd" Property="Background" Value="{DynamicResource Hover}"/>
                                                            </Trigger>
                                                        </ControlTemplate.Triggers>
                                                    </ControlTemplate>
                                                </Button.Template>
                                            </Button>
                                            <Button Grid.Column="1" Content="&#x2715;" Click="ServerDelete_Click"
                                                    Tag="{Binding}" Cursor="Hand" FontSize="11"
                                                    Foreground="{DynamicResource InkSoft}" ToolTip="Remove">
                                                <Button.Template>
                                                    <ControlTemplate TargetType="Button">
                                                        <Border x:Name="bd" Background="Transparent" CornerRadius="4"
                                                                Padding="8,7" Margin="2,0,0,0">
                                                            <ContentPresenter/>
                                                        </Border>
                                                        <ControlTemplate.Triggers>
                                                            <Trigger Property="IsMouseOver" Value="True">
                                                                <Setter TargetName="bd" Property="Background" Value="#33C8322B"/>
                                                                <Setter Property="Foreground" Value="#C8322B"/>
                                                            </Trigger>
                                                        </ControlTemplate.Triggers>
                                                    </ControlTemplate>
                                                </Button.Template>
                                            </Button>
                                        </Grid>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                                <Border Grid.Row="1" BorderBrush="{DynamicResource Line}" BorderThickness="0,1,0,0" Margin="3,2,3,0">
                                    <Button x:Name="AddServerButton" Click="AddServer_Click" Cursor="Hand"
                                            Content="Add print server…"
                                            HorizontalContentAlignment="Left" Foreground="{DynamicResource Accent}">
                                        <Button.Template>
                                            <ControlTemplate TargetType="Button">
                                                <Border x:Name="bd" Background="Transparent" CornerRadius="4" Padding="10,8">
                                                    <StackPanel Orientation="Horizontal">
                                                        <TextBlock Text="&#xE710;" FontFamily="Segoe MDL2 Assets"
                                                                   FontSize="12" Margin="0,0,8,0" VerticalAlignment="Center"/>
                                                        <ContentPresenter VerticalAlignment="Center"/>
                                                    </StackPanel>
                                                </Border>
                                                <ControlTemplate.Triggers>
                                                    <Trigger Property="IsMouseOver" Value="True">
                                                        <Setter TargetName="bd" Property="Background" Value="{DynamicResource Hover}"/>
                                                    </Trigger>
                                                </ControlTemplate.Triggers>
                                            </ControlTemplate>
                                        </Button.Template>
                                    </Button>
                                </Border>
                            </Grid>
                        </Border>
                    </Popup>
                </Grid>
                <Button x:Name="LoadButton" Width="34" Height="34" Margin="8,0,0,0"
                        Click="LoadButton_Click" Cursor="Hand">
                    <Button.Template>
                        <ControlTemplate TargetType="Button">
                            <Border x:Name="bd" Background="Transparent" CornerRadius="4"
                                    BorderBrush="{DynamicResource Line}" BorderThickness="1">
                                <TextBlock Text="&#xE72C;" FontFamily="Segoe MDL2 Assets" FontSize="14"
                                           Foreground="{DynamicResource InkSoft}"
                                           HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            </Border>
                            <ControlTemplate.Triggers>
                                <Trigger Property="IsMouseOver" Value="True">
                                    <Setter TargetName="bd" Property="Background" Value="{DynamicResource Hover}"/>
                                </Trigger>
                                <Trigger Property="IsEnabled" Value="False">
                                    <Setter Property="Opacity" Value="0.45"/>
                                </Trigger>
                            </ControlTemplate.Triggers>
                        </ControlTemplate>
                    </Button.Template>
                </Button>
                <Button x:Name="AddDeviceButton" Content="Add device" Style="{StaticResource ActionButton}"
                        MinWidth="118" Height="34" FontSize="13" Margin="8,0,0,0" Click="AddDevice_Click"/>
                <ContentControl x:Name="LoadSpinner" Style="{StaticResource Spinner}"
                                Margin="8,0,0,0" VerticalAlignment="Center" Visibility="Collapsed"/>
            </StackPanel>

            <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
                <Button x:Name="ExportButton" Width="30" Height="30" Margin="0,0,6,0"
                        Click="Export_Click" Cursor="Hand">
                    <Button.Template>
                        <ControlTemplate TargetType="Button">
                            <Border x:Name="bd" Background="Transparent" CornerRadius="4"
                                    BorderBrush="{DynamicResource Line}" BorderThickness="1">
                                <TextBlock Text="&#xE74E;" FontFamily="Segoe MDL2 Assets" FontSize="14"
                                           Foreground="{DynamicResource InkSoft}"
                                           HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            </Border>
                            <ControlTemplate.Triggers>
                                <Trigger Property="IsMouseOver" Value="True">
                                    <Setter TargetName="bd" Property="Background" Value="{DynamicResource Hover}"/>
                                </Trigger>
                            </ControlTemplate.Triggers>
                        </ControlTemplate>
                    </Button.Template>
                </Button>
                <ComboBox x:Name="ThemeBox" Width="54" Height="30"
                          Style="{StaticResource IconCombo}"
                          SelectionChanged="ThemeBox_SelectionChanged" Margin="0,0,6,0"/>
                <ToggleButton x:Name="LangButton" Width="40" Height="30" Margin="0,0,6,0" Cursor="Hand">
                    <ToggleButton.Template>
                        <ControlTemplate TargetType="ToggleButton">
                            <Border x:Name="bd" Background="Transparent" CornerRadius="4"
                                    BorderBrush="{DynamicResource Line}" BorderThickness="1">
                                <TextBlock Text="&#xE774;" FontFamily="Segoe MDL2 Assets" FontSize="14"
                                           Foreground="{DynamicResource InkSoft}"
                                           HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            </Border>
                            <ControlTemplate.Triggers>
                                <Trigger Property="IsMouseOver" Value="True">
                                    <Setter TargetName="bd" Property="Background" Value="{DynamicResource Hover}"/>
                                </Trigger>
                                <Trigger Property="IsChecked" Value="True">
                                    <Setter TargetName="bd" Property="Background" Value="{DynamicResource AccentSoft}"/>
                                </Trigger>
                            </ControlTemplate.Triggers>
                        </ControlTemplate>
                    </ToggleButton.Template>
                </ToggleButton>
                <Popup IsOpen="{Binding IsChecked, ElementName=LangButton, Mode=TwoWay}"
                       PlacementTarget="{Binding ElementName=LangButton}" Placement="Bottom"
                       AllowsTransparency="True" StaysOpen="False">
                    <Border Background="{DynamicResource Card}" BorderBrush="{DynamicResource Line}"
                            BorderThickness="1" CornerRadius="6" Margin="4" Padding="6">
                        <Border.Effect>
                            <DropShadowEffect BlurRadius="12" ShadowDepth="2" Opacity="0.25"/>
                        </Border.Effect>
                        <!-- 5 languages per column, columns side by side — all visible, no scrolling -->
                        <ItemsControl x:Name="LangList">
                            <ItemsControl.ItemsPanel>
                                <ItemsPanelTemplate>
                                    <StackPanel Orientation="Horizontal"/>
                                </ItemsPanelTemplate>
                            </ItemsControl.ItemsPanel>
                        </ItemsControl>
                    </Border>
                </Popup>
                <ToggleButton x:Name="ColumnsButton" Width="30" Height="30" Margin="0,0,6,0" Cursor="Hand">
                    <ToggleButton.Template>
                        <ControlTemplate TargetType="ToggleButton">
                            <Border x:Name="bd" Background="Transparent" CornerRadius="4"
                                    BorderBrush="{DynamicResource Line}" BorderThickness="1">
                                <TextBlock Text="&#xE71D;" FontFamily="Segoe MDL2 Assets" FontSize="14"
                                           Foreground="{DynamicResource InkSoft}"
                                           HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            </Border>
                            <ControlTemplate.Triggers>
                                <Trigger Property="IsMouseOver" Value="True">
                                    <Setter TargetName="bd" Property="Background" Value="{DynamicResource Hover}"/>
                                </Trigger>
                                <Trigger Property="IsChecked" Value="True">
                                    <Setter TargetName="bd" Property="Background" Value="{DynamicResource AccentSoft}"/>
                                </Trigger>
                            </ControlTemplate.Triggers>
                        </ControlTemplate>
                    </ToggleButton.Template>
                </ToggleButton>
                <Popup IsOpen="{Binding IsChecked, ElementName=ColumnsButton, Mode=TwoWay}"
                       PlacementTarget="{Binding ElementName=ColumnsButton}" Placement="Bottom"
                       AllowsTransparency="True" StaysOpen="False">
                    <Border Background="{DynamicResource Card}" BorderBrush="{DynamicResource Line}"
                            BorderThickness="1" CornerRadius="6" Margin="4" Padding="6" MinWidth="200">
                        <Border.Effect>
                            <DropShadowEffect BlurRadius="12" ShadowDepth="2" Opacity="0.25"/>
                        </Border.Effect>
                        <StackPanel>
                            <TextBlock x:Name="ColumnsTitle" Text="Columns" FontWeight="SemiBold"
                                       Margin="6,4,6,6" Foreground="{DynamicResource InkSoft}" FontSize="12"/>
                            <StackPanel Orientation="Horizontal" Margin="6,0,6,8">
                                <RadioButton x:Name="AlignLeftOption" GroupName="colAlign" Margin="0,0,14,0"
                                             Foreground="{DynamicResource Ink}" Checked="Align_Changed"/>
                                <RadioButton x:Name="AlignCenterOption" GroupName="colAlign"
                                             Foreground="{DynamicResource Ink}" Checked="Align_Changed"/>
                            </StackPanel>
                            <Border Height="1" Background="{DynamicResource Line}" Margin="6,0,6,6"/>
                            <ItemsControl x:Name="ColumnList">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <CheckBox Content="{Binding Label}" IsChecked="{Binding Visible, Mode=TwoWay}"
                                                  IsEnabled="{Binding CanHide}" Margin="6,4"
                                                  Foreground="{DynamicResource Ink}"
                                                  Checked="ColumnToggle_Changed" Unchecked="ColumnToggle_Changed"/>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </StackPanel>
                    </Border>
                </Popup>
                <Button x:Name="AboutButton" Width="30" Height="30" Click="AboutButton_Click"
                        Cursor="Hand" ToolTip="About">
                    <Button.Template>
                        <ControlTemplate TargetType="Button">
                            <Border x:Name="bd" Background="Transparent" CornerRadius="4"
                                    BorderBrush="{DynamicResource Line}" BorderThickness="1">
                                <TextBlock Text="&#xE946;" FontFamily="Segoe MDL2 Assets" FontSize="15" Foreground="{DynamicResource InkSoft}"
                                           HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            </Border>
                            <ControlTemplate.Triggers>
                                <Trigger Property="IsMouseOver" Value="True">
                                    <Setter TargetName="bd" Property="Background" Value="{DynamicResource Hover}"/>
                                </Trigger>
                            </ControlTemplate.Triggers>
                        </ControlTemplate>
                    </Button.Template>
                </Button>
            </StackPanel>
        </Grid>

        <!-- Search -->
        <Grid Grid.Row="1" Margin="0,0,0,10">
            <TextBox x:Name="SearchBox" Style="{StaticResource ThemedTextBox}"
                     Padding="34,8,8,8" TextChanged="SearchBox_TextChanged"
                     GotKeyboardFocus="SearchBox_FocusChanged" LostKeyboardFocus="SearchBox_FocusChanged"/>
            <TextBlock Text="&#xE721;" FontFamily="Segoe MDL2 Assets" FontSize="14" Margin="11,0,0,0"
                       VerticalAlignment="Center" IsHitTestVisible="False" Foreground="{DynamicResource Hint}"/>
            <TextBlock x:Name="SearchHint" Text="Search printers…" Foreground="{DynamicResource Hint}"
                       Margin="36,0,0,0" VerticalAlignment="Center" IsHitTestVisible="False"/>
        </Grid>

        <!-- Printer list -->
        <Border Grid.Row="2" Background="{DynamicResource Card}" BorderBrush="{DynamicResource Line}"
                BorderThickness="1" CornerRadius="6">
            <Grid>
                <ListView x:Name="List" BorderThickness="0" Background="Transparent"
                          Foreground="{DynamicResource Ink}"
                          GridViewColumnHeader.Click="Header_Click"
                          VirtualizingPanel.IsVirtualizing="True"
                          VirtualizingPanel.IsVirtualizingWhenGrouping="True"
                          VirtualizingPanel.VirtualizationMode="Recycling"
                          ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                          SelectionMode="Extended"
                          MouseDoubleClick="List_MouseDoubleClick"
                          KeyDown="List_KeyDown"
                          PreviewMouseRightButtonDown="List_PreviewMouseRightButtonDown"
                          SizeChanged="List_SizeChanged">
                    <ListView.ItemContainerStyle>
                        <Style TargetType="ListViewItem">
                            <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
                            <Setter Property="VerticalContentAlignment" Value="Center"/>
                            <Setter Property="Height" Value="58"/>
                            <Setter Property="Foreground" Value="{DynamicResource Ink}"/>
                            <Setter Property="ContextMenu" Value="{StaticResource RowMenu}"/>
                            <Setter Property="Template">
                                <Setter.Value>
                                    <ControlTemplate TargetType="ListViewItem">
                                        <Border x:Name="bd" Background="Transparent"
                                                BorderBrush="{DynamicResource Line}" BorderThickness="0,0,0,1"
                                                Padding="10,7">
                                            <GridViewRowPresenter Content="{TemplateBinding Content}"
                                                                  Columns="{TemplateBinding GridView.ColumnCollection}"/>
                                        </Border>
                                        <ControlTemplate.Triggers>
                                            <DataTrigger Binding="{Binding Installed}" Value="True">
                                                <Setter TargetName="bd" Property="Background" Value="{DynamicResource PinnedBg}"/>
                                            </DataTrigger>
                                            <!-- Default printer: clearly tinted row (replaces the old star) -->
                                            <DataTrigger Binding="{Binding IsDefault}" Value="True">
                                                <Setter TargetName="bd" Property="Background" Value="{DynamicResource DefaultRowBg}"/>
                                            </DataTrigger>
                                            <Trigger Property="IsMouseOver" Value="True">
                                                <Setter TargetName="bd" Property="Background" Value="{DynamicResource Hover}"/>
                                            </Trigger>
                                            <Trigger Property="IsSelected" Value="True">
                                                <Setter TargetName="bd" Property="Background" Value="{DynamicResource AccentSoft}"/>
                                            </Trigger>
                                        </ControlTemplate.Triggers>
                                    </ControlTemplate>
                                </Setter.Value>
                            </Setter>
                        </Style>
                    </ListView.ItemContainerStyle>
                    <ListView.GroupStyle>
                        <GroupStyle>
                            <GroupStyle.HeaderTemplate>
                                <DataTemplate>
                                    <Border Padding="10,14,10,6">
                                        <StackPanel Orientation="Horizontal">
                                            <TextBlock Text="{Binding Name}" FontSize="14" FontWeight="SemiBold"
                                                       Foreground="{DynamicResource Ink}"/>
                                            <Border Background="{DynamicResource AccentSoft}" CornerRadius="9"
                                                    Padding="8,1" Margin="10,0,0,0" VerticalAlignment="Center">
                                                <TextBlock Text="{Binding ItemCount}" FontSize="11"
                                                           Foreground="{DynamicResource Accent}"/>
                                            </Border>
                                        </StackPanel>
                                    </Border>
                                </DataTemplate>
                            </GroupStyle.HeaderTemplate>
                        </GroupStyle>
                    </ListView.GroupStyle>
                    <ListView.View>
                        <GridView>
                            <GridView.ColumnHeaderContainerStyle>
                                <Style TargetType="GridViewColumnHeader">
                                    <Setter Property="FontWeight" Value="Normal"/>
                                    <Setter Property="FontSize" Value="12.5"/>
                                    <Setter Property="Foreground" Value="{DynamicResource InkSoft}"/>
                                    <Setter Property="Template">
                                        <Setter.Value>
                                            <!-- Full retemplate: flat Win11 header, no legacy gradient chrome -->
                                            <ControlTemplate TargetType="GridViewColumnHeader">
                                                <Grid>
                                                    <Border x:Name="bd" Background="Transparent"
                                                            BorderBrush="{DynamicResource Line}" BorderThickness="0,0,0,1"
                                                            Padding="10,8">
                                                        <ContentPresenter HorizontalAlignment="{DynamicResource CellAlign}" VerticalAlignment="Center"
                                                                          RecognizesAccessKey="False"/>
                                                    </Border>
                                                    <!-- PART_HeaderGripper enables drag-resizing, exactly like Explorer -->
                                                    <Thumb x:Name="PART_HeaderGripper" HorizontalAlignment="Right"
                                                           Width="8" Margin="0,2,-4,2" Cursor="SizeWE">
                                                        <Thumb.Template>
                                                            <ControlTemplate TargetType="Thumb">
                                                                <Border Background="Transparent">
                                                                    <Rectangle Width="1" Fill="{DynamicResource Line}"
                                                                               VerticalAlignment="Stretch" HorizontalAlignment="Center"/>
                                                                </Border>
                                                            </ControlTemplate>
                                                        </Thumb.Template>
                                                    </Thumb>
                                                </Grid>
                                                <ControlTemplate.Triggers>
                                                    <Trigger Property="IsMouseOver" Value="True">
                                                        <Setter TargetName="bd" Property="Background" Value="{DynamicResource Hover}"/>
                                                    </Trigger>
                                                    <Trigger Property="IsPressed" Value="True">
                                                        <Setter TargetName="bd" Property="Background" Value="{DynamicResource AccentSoft}"/>
                                                    </Trigger>
                                                </ControlTemplate.Triggers>
                                            </ControlTemplate>
                                        </Setter.Value>
                                    </Setter>
                                </Style>
                            </GridView.ColumnHeaderContainerStyle>

                            <GridViewColumn x:Name="ColPrinter" Width="290" Header="Printer">
                                <GridViewColumn.CellTemplate>
                                    <DataTemplate DataType="{x:Type local:PrinterRow}">
                                        <StackPanel HorizontalAlignment="{DynamicResource CellAlign}">
                                            <StackPanel Orientation="Horizontal">
                                                <TextBlock Text="{Binding Name}" FontWeight="Medium" TextTrimming="CharacterEllipsis"/>
                                            </StackPanel>
                                            <TextBlock Text="{Binding CommentDisplay}" Foreground="{DynamicResource InkSoft}"
                                                       FontSize="11" TextTrimming="CharacterEllipsis"
                                                       Visibility="{Binding CommentDisplay, Converter={x:Static local:Converters.HideIfEmpty}}"/>
                                        </StackPanel>
                                    </DataTemplate>
                                </GridViewColumn.CellTemplate>
                            </GridViewColumn>

                            <GridViewColumn x:Name="ColLocation" Width="190" Header="Location">
                                <GridViewColumn.CellTemplate>
                                    <DataTemplate DataType="{x:Type local:PrinterRow}">
                                        <StackPanel HorizontalAlignment="{DynamicResource CellAlign}">
                                            <TextBlock Text="{Binding LocationDisplay}" TextTrimming="CharacterEllipsis"
                                                       Foreground="{DynamicResource InkSoft}"/>
                                            <TextBlock Text="{Binding ServerLine}" FontSize="10"
                                                       Foreground="{DynamicResource Hint}" TextTrimming="CharacterEllipsis"
                                                       Visibility="{Binding ServerLine, Converter={x:Static local:Converters.HideIfEmpty}}"/>
                                        </StackPanel>
                                    </DataTemplate>
                                </GridViewColumn.CellTemplate>
                            </GridViewColumn>

                            <GridViewColumn x:Name="ColIp" Width="120" Header="IP">
                                <GridViewColumn.CellTemplate>
                                    <DataTemplate DataType="{x:Type local:PrinterRow}">
                                        <StackPanel Orientation="Horizontal" HorizontalAlignment="{DynamicResource CellAlign}">
                                            <Button Click="OpenIp_Click" Cursor="Hand"
                                                    ToolTip="{Binding IpUrl}" VerticalAlignment="Center"
                                                    Visibility="{Binding IpUrl, Converter={x:Static local:Converters.HideIfEmpty}}">
                                                <Button.Template>
                                                    <ControlTemplate TargetType="Button">
                                                        <TextBlock x:Name="txt" Text="{Binding IpDisplay}" Foreground="{DynamicResource Accent}"
                                                                   TextTrimming="CharacterEllipsis"/>
                                                        <ControlTemplate.Triggers>
                                                            <Trigger Property="IsMouseOver" Value="True">
                                                                <Setter TargetName="txt" Property="TextDecorations" Value="Underline"/>
                                                            </Trigger>
                                                        </ControlTemplate.Triggers>
                                                    </ControlTemplate>
                                                </Button.Template>
                                            </Button>
                                            <TextBlock Text="{Binding IpDisplay}" Foreground="{DynamicResource InkSoft}"
                                                       TextTrimming="CharacterEllipsis" ToolTip="{Binding Port}"
                                                       VerticalAlignment="Center"
                                                       Visibility="{Binding IpUrl, Converter={x:Static local:Converters.ShowIfEmpty}}"/>
                                            <Button Style="{StaticResource CopyButton}" Tag="{Binding IpDisplay}"
                                                    Click="Copy_Click"
                                                    Visibility="{Binding Ip, Converter={x:Static local:Converters.HideIfEmpty}}"/>
                                        </StackPanel>
                                    </DataTemplate>
                                </GridViewColumn.CellTemplate>
                            </GridViewColumn>

                            <GridViewColumn x:Name="ColStatus" Width="130" Header="Status">
                                <GridViewColumn.CellTemplate>
                                    <DataTemplate DataType="{x:Type local:PrinterRow}">
                                        <StackPanel ToolTip="{Binding StatusTooltip}" HorizontalAlignment="{DynamicResource CellAlign}">
                                            <StackPanel Orientation="Horizontal">
                                                <Ellipse Width="8" Height="8" Fill="{Binding StatusBrush}"
                                                         VerticalAlignment="Center" Margin="0,0,7,0"/>
                                                <TextBlock Text="{Binding StatusText}" TextTrimming="CharacterEllipsis"/>
                                            </StackPanel>
                                            <TextBlock Text="{Binding ProbeText}" FontSize="10" Margin="15,1,0,0"
                                                       ToolTip="{Binding ProbeTip}"
                                                       Visibility="{Binding ProbeText, Converter={x:Static local:Converters.HideIfEmpty}}">
                                                <TextBlock.Style>
                                                    <Style TargetType="TextBlock">
                                                        <Setter Property="Foreground" Value="{DynamicResource Hint}"/>
                                                        <Style.Triggers>
                                                            <DataTrigger Binding="{Binding ProbeIsGood}" Value="True">
                                                                <Setter Property="Foreground" Value="#1E8A4C"/>
                                                            </DataTrigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </TextBlock.Style>
                                            </TextBlock>
                                        </StackPanel>
                                    </DataTemplate>
                                </GridViewColumn.CellTemplate>
                            </GridViewColumn>

                            <GridViewColumn x:Name="ColToner" Width="120" Header="Toner">
                                <GridViewColumn.CellTemplate>
                                    <DataTemplate DataType="{x:Type local:PrinterRow}">
                                        <!-- Signature element: miniature CMYK ink gauge -->
                                        <ItemsControl HorizontalAlignment="{DynamicResource CellAlign}" ItemsSource="{Binding Toner}" VerticalAlignment="Center">
                                            <ItemsControl.ItemTemplate>
                                                <DataTemplate DataType="{x:Type local:TonerBar}">
                                                    <Grid Margin="0,1.5" ToolTip="{Binding Tooltip}">
                                                        <Border Width="60" Height="7" HorizontalAlignment="Left"
                                                                Background="{DynamicResource TonerTrack}" CornerRadius="3.5"/>
                                                        <Border Width="{Binding Width}" Height="7" HorizontalAlignment="Left"
                                                                CornerRadius="3.5">
                                                            <Border.Style>
                                                                <Style TargetType="Border">
                                                                    <Setter Property="Background" Value="{DynamicResource TonerK}"/>
                                                                    <Style.Triggers>
                                                                        <DataTrigger Binding="{Binding Kind}" Value="c">
                                                                            <Setter Property="Background" Value="#00B0D8"/>
                                                                        </DataTrigger>
                                                                        <DataTrigger Binding="{Binding Kind}" Value="m">
                                                                            <Setter Property="Background" Value="#E0308A"/>
                                                                        </DataTrigger>
                                                                        <DataTrigger Binding="{Binding Kind}" Value="y">
                                                                            <Setter Property="Background" Value="#F2C100"/>
                                                                        </DataTrigger>
                                                                    </Style.Triggers>
                                                                </Style>
                                                            </Border.Style>
                                                        </Border>
                                                    </Grid>
                                                </DataTemplate>
                                            </ItemsControl.ItemTemplate>
                                        </ItemsControl>
                                    </DataTemplate>
                                </GridViewColumn.CellTemplate>
                            </GridViewColumn>

                            <GridViewColumn x:Name="ColJobs" Width="70" Header="Jobs">
                                <GridViewColumn.CellTemplate>
                                    <DataTemplate DataType="{x:Type local:PrinterRow}">
                                        <StackPanel Orientation="Horizontal" HorizontalAlignment="{DynamicResource CellAlign}">
                                            <TextBlock Text="{Binding JobsText}" VerticalAlignment="Center"/>
                                            <Button Click="ClearQueue_Click" Width="20" Height="20" Margin="6,0,0,0"
                                                    Cursor="Hand" ToolTip="{Binding ClearQueueLabel}"
                                                    Visibility="{Binding JobsText, Converter={x:Static local:Converters.HideIfEmpty}}">
                                                <Button.Template>
                                                    <ControlTemplate TargetType="Button">
                                                        <Border x:Name="bd" Background="Transparent" CornerRadius="3">
                                                            <TextBlock Text="&#xE711;" FontFamily="Segoe MDL2 Assets" FontSize="10"
                                                                       Foreground="{DynamicResource Hint}"
                                                                       HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                                        </Border>
                                                        <ControlTemplate.Triggers>
                                                            <Trigger Property="IsMouseOver" Value="True">
                                                                <Setter TargetName="bd" Property="Background" Value="{DynamicResource Hover}"/>
                                                            </Trigger>
                                                        </ControlTemplate.Triggers>
                                                    </ControlTemplate>
                                                </Button.Template>
                                            </Button>
                                        </StackPanel>
                                    </DataTemplate>
                                </GridViewColumn.CellTemplate>
                            </GridViewColumn>

                            <GridViewColumn x:Name="ColModel" Width="160" Header="Model">
                                <GridViewColumn.CellTemplate>
                                    <DataTemplate DataType="{x:Type local:PrinterRow}">
                                        <TextBlock HorizontalAlignment="{DynamicResource CellAlign}" Text="{Binding Model}" TextTrimming="CharacterEllipsis"
                                                   ToolTip="{Binding Model}" Foreground="{DynamicResource InkSoft}"/>
                                    </DataTemplate>
                                </GridViewColumn.CellTemplate>
                            </GridViewColumn>

                            <GridViewColumn x:Name="ColSerial" Width="130" Header="Serial">
                                <GridViewColumn.CellTemplate>
                                    <DataTemplate DataType="{x:Type local:PrinterRow}">
                                        <StackPanel Orientation="Horizontal" HorizontalAlignment="{DynamicResource CellAlign}">
                                            <TextBlock Text="{Binding Serial}" TextTrimming="CharacterEllipsis"
                                                       Foreground="{DynamicResource InkSoft}" VerticalAlignment="Center"/>
                                            <Button Style="{StaticResource CopyButton}" Tag="{Binding Serial}"
                                                    Click="Copy_Click"
                                                    Visibility="{Binding Serial, Converter={x:Static local:Converters.HideIfEmpty}}"/>
                                        </StackPanel>
                                    </DataTemplate>
                                </GridViewColumn.CellTemplate>
                            </GridViewColumn>

                            <GridViewColumn x:Name="ColPages" Width="100" Header="Pages">
                                <GridViewColumn.CellTemplate>
                                    <DataTemplate DataType="{x:Type local:PrinterRow}">
                                        <TextBlock HorizontalAlignment="{DynamicResource CellAlign}" Text="{Binding PagesText}" Foreground="{DynamicResource InkSoft}"/>
                                    </DataTemplate>
                                </GridViewColumn.CellTemplate>
                            </GridViewColumn>

                            <GridViewColumn x:Name="ColUptime" Width="90" Header="Uptime">
                                <GridViewColumn.CellTemplate>
                                    <DataTemplate DataType="{x:Type local:PrinterRow}">
                                        <TextBlock HorizontalAlignment="{DynamicResource CellAlign}" Text="{Binding UptimeText}" Foreground="{DynamicResource InkSoft}"/>
                                    </DataTemplate>
                                </GridViewColumn.CellTemplate>
                            </GridViewColumn>

                            <GridViewColumn x:Name="ColTrays" Width="150" Header="Paper">
                                <GridViewColumn.CellTemplate>
                                    <DataTemplate DataType="{x:Type local:PrinterRow}">
                                        <TextBlock HorizontalAlignment="{DynamicResource CellAlign}" Text="{Binding Trays}" TextTrimming="CharacterEllipsis"
                                                   ToolTip="{Binding Trays}" Foreground="{DynamicResource InkSoft}"/>
                                    </DataTemplate>
                                </GridViewColumn.CellTemplate>
                            </GridViewColumn>

                            <GridViewColumn x:Name="ColDisplay" Width="150" Header="Display">
                                <GridViewColumn.CellTemplate>
                                    <DataTemplate DataType="{x:Type local:PrinterRow}">
                                        <TextBlock HorizontalAlignment="{DynamicResource CellAlign}" Text="{Binding Display}" TextTrimming="CharacterEllipsis"
                                                   ToolTip="{Binding Display}" Foreground="{DynamicResource InkSoft}"/>
                                    </DataTemplate>
                                </GridViewColumn.CellTemplate>
                            </GridViewColumn>

                            <GridViewColumn x:Name="ColDriver" Width="170" Header="Driver">
                                <GridViewColumn.CellTemplate>
                                    <DataTemplate DataType="{x:Type local:PrinterRow}">
                                        <TextBlock HorizontalAlignment="{DynamicResource CellAlign}" Text="{Binding Driver}" TextTrimming="CharacterEllipsis"
                                                   ToolTip="{Binding Driver}" Foreground="{DynamicResource InkSoft}"/>
                                    </DataTemplate>
                                </GridViewColumn.CellTemplate>
                            </GridViewColumn>

                            <GridViewColumn x:Name="ColDriverType" Width="100" Header="Driver type">
                                <GridViewColumn.CellTemplate>
                                    <DataTemplate DataType="{x:Type local:PrinterRow}">
                                        <TextBlock Text="{Binding DriverTypeText}" ToolTip="{Binding DriverTypeTip}">
                                            <TextBlock.Style>
                                                <Style TargetType="TextBlock">
                                                    <Setter Property="Foreground" Value="{DynamicResource InkSoft}"/>
                                                    <Style.Triggers>
                                                        <!-- Type 3 = the ones that cause admin prompts — flag them -->
                                                        <DataTrigger Binding="{Binding DriverTypeText}" Value="Type 3">
                                                            <Setter Property="Foreground" Value="#C87E0A"/>
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </TextBlock.Style>
                                        </TextBlock>
                                    </DataTemplate>
                                </GridViewColumn.CellTemplate>
                            </GridViewColumn>

                            <GridViewColumn x:Name="ColDefault" Width="80" Header="Default">
                                <GridViewColumn.CellTemplate>
                                    <DataTemplate DataType="{x:Type local:PrinterRow}">
                                        <!-- Radio metaphor: exactly one default across the list -->
                                        <Button Click="SetDefault_Click" Cursor="Hand" Width="26" Height="26"
                                                HorizontalAlignment="Left"
                                                ToolTip="{Binding SetDefaultLabel}"
                                                IsEnabled="{Binding IsDefault, Converter={x:Static local:Converters.Invert}}"
                                                Visibility="{Binding Installed, Converter={x:Static local:Converters.ShowIfTrue}}">
                                            <Button.Template>
                                                <ControlTemplate TargetType="Button">
                                                    <Grid Background="Transparent">
                                                        <Ellipse x:Name="ring" Width="16" Height="16"
                                                                 Stroke="{DynamicResource InkSoft}" StrokeThickness="1.4"
                                                                 Fill="Transparent"/>
                                                        <Ellipse x:Name="dot" Width="8" Height="8"
                                                                 Fill="{DynamicResource Accent}" Visibility="Collapsed"/>
                                                    </Grid>
                                                    <ControlTemplate.Triggers>
                                                        <DataTrigger Binding="{Binding IsDefault}" Value="True">
                                                            <Setter TargetName="ring" Property="Stroke" Value="{DynamicResource Accent}"/>
                                                            <Setter TargetName="ring" Property="StrokeThickness" Value="1.8"/>
                                                            <Setter TargetName="dot" Property="Visibility" Value="Visible"/>
                                                        </DataTrigger>
                                                        <Trigger Property="IsMouseOver" Value="True">
                                                            <Setter TargetName="ring" Property="Stroke" Value="{DynamicResource Accent}"/>
                                                        </Trigger>
                                                    </ControlTemplate.Triggers>
                                                </ControlTemplate>
                                            </Button.Template>
                                        </Button>
                                    </DataTemplate>
                                </GridViewColumn.CellTemplate>
                            </GridViewColumn>

                            <GridViewColumn x:Name="ColAction" Width="150" Header="Installed">
                                <GridViewColumn.CellTemplate>
                                    <DataTemplate DataType="{x:Type local:PrinterRow}">
                                        <Grid HorizontalAlignment="Center">
                                            <StackPanel Orientation="Horizontal">
                                                <Button Content="{Binding ActionLabel}" Width="104"
                                                        VerticalAlignment="Center" Click="RowAction_Click"
                                                        IsEnabled="{Binding Busy, Converter={x:Static local:Converters.Invert}}">
                                                    <Button.Style>
                                                        <Style TargetType="Button" BasedOn="{StaticResource RowActionButton}">
                                                            <Style.Triggers>
                                                                <DataTrigger Binding="{Binding Installed}" Value="True">
                                                                    <Setter Property="Tag" Value="danger"/>
                                                                </DataTrigger>
                                                            </Style.Triggers>
                                                        </Style>
                                                    </Button.Style>
                                                </Button>
                                                <!-- One 28px slot: test-page button normally, progress ring while busy -->
                                                <Grid Width="28" Height="26" Margin="6,0,0,0" VerticalAlignment="Center">
                                                    <Button Click="TestPage_Click" Cursor="Hand"
                                                            ToolTip="{Binding TestPageLabel}">
                                                        <Button.Style>
                                                            <Style TargetType="Button">
                                                                <Setter Property="Visibility" Value="Hidden"/>
                                                                <Style.Triggers>
                                                                    <DataTrigger Binding="{Binding Installed}" Value="True">
                                                                        <Setter Property="Visibility" Value="Visible"/>
                                                                    </DataTrigger>
                                                                    <DataTrigger Binding="{Binding Busy}" Value="True">
                                                                        <Setter Property="Visibility" Value="Hidden"/>
                                                                    </DataTrigger>
                                                                </Style.Triggers>
                                                            </Style>
                                                        </Button.Style>
                                                        <Button.Template>
                                                            <ControlTemplate TargetType="Button">
                                                                <Border x:Name="bd" Background="Transparent" CornerRadius="4"
                                                                        BorderBrush="{DynamicResource Line}" BorderThickness="1">
                                                                    <TextBlock Text="&#xE749;" FontFamily="Segoe MDL2 Assets" FontSize="13"
                                                                               Foreground="{DynamicResource Accent}"
                                                                               HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                                                </Border>
                                                                <ControlTemplate.Triggers>
                                                                    <Trigger Property="IsMouseOver" Value="True">
                                                                        <Setter TargetName="bd" Property="Background" Value="{DynamicResource Hover}"/>
                                                                    </Trigger>
                                                                </ControlTemplate.Triggers>
                                                            </ControlTemplate>
                                                        </Button.Template>
                                                    </Button>
                                                    <ContentControl Style="{StaticResource Spinner}"
                                                                    HorizontalAlignment="Center" VerticalAlignment="Center"
                                                                    Visibility="{Binding Busy, Converter={x:Static local:Converters.ShowIfTrue}}"/>
                                                </Grid>
                                            </StackPanel>
                                        </Grid>
                                    </DataTemplate>
                                </GridViewColumn.CellTemplate>
                            </GridViewColumn>
                        </GridView>
                    </ListView.View>
                </ListView>

            </Grid>
        </Border>

        <!-- Status bar -->
        <Grid Grid.Row="3" Margin="2,10,2,0">
            <TextBlock x:Name="CountText" Foreground="{DynamicResource InkSoft}" FontSize="12"/>
        </Grid>
    </Grid>
</Window>
